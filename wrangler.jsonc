// Cloudflare Workers deployment (Free plan). Deployed from the cloudflare-prod
// branch by .github/workflows/cloudflare.yml; build with `npm run cf:build`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arena-criolla",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": ".cloudflare/public",
    "binding": "ASSETS",
    // Paths with no file (/, /ws, /api/*) fall through to the Worker.
    "not_found_handling": "none",
    "html_handling": "none",
    // The one asset that negotiates AVIF via the Accept header.
    "run_worker_first": ["/assets/caracas.webp"],
  },
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "ArenaLobby" }],
  },
  // The Free plan requires SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArenaLobby"] }],
  "observability": { "enabled": true },
}
