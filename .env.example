# Server-only. Never put this key in VITE_* variables or commit .env.
OPENAI_API_KEY=
OPENAI_DESIGN_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# The public workshop is disabled; this flag alone cannot enable it.
ARENA_CREATOR_ENABLED=false
# App-side Codex generation gate. This cannot change OpenAI's plan-first billing.
ARENA_CODEX_BILLING_POLICY=chatgpt-plan-and-credits
# SQLite, private reference photos, generated sprite sheets and public catalog.
ARENA_DATA_DIR=./data/creator
# One Node process. Bounded generation, uploads and rolling 24-hour attempt budgets.
ARENA_CREATOR_CONCURRENCY=2
ARENA_CREATOR_CAPACITY=12
ARENA_CREATOR_UPLOADS=2
ARENA_CREATOR_JOB_TIMEOUT_MS=300000
ARENA_CREATOR_UPLOAD_TIMEOUT_MS=30000
ARENA_CREATOR_DAILY_ATTEMPTS=50
ARENA_CREATOR_USER_DAILY_ATTEMPTS=6
PORT=5173
# Public origin for canonical, social image and sitemap URLs behind a proxy.
# Leave empty during local development to use the incoming request origin.
# Production uses https://arenacriolla.com.
ARENA_PUBLIC_URL=
# Comma-separated trusted proxy IPs/CIDRs. Leave empty when serving clients directly.
# Oracle's private Docker proxy uses loopback,uniquelocal and no public app port.
ARENA_TRUST_PROXY=
