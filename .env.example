PORT=5173
# Public origin for canonical, social image and sitemap URLs, e.g. https://arena.example.com.
# Leave empty during local development to use the incoming request origin.
ARENA_PUBLIC_URL=
# Comma-separated trusted proxy IPs/CIDRs. Required behind an HTTPS reverse proxy;
# "loopback,uniquelocal" covers a proxy on the same host or a Docker network.
# Leave empty when serving clients directly.
ARENA_TRUST_PROXY=
