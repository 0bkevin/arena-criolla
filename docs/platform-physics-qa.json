  "findings": [
    {
      "issue": "CPU waits on an elevated platform when its rival stands below.",
      "before": {
        "command": "node --import tsx --test --test-name-pattern='CPU descends' tests/platform-physics.test.ts",
        "result": "FAILED: caracas: CPU remains stranded at y=392 after 240 simulated frames."
      },
      "cause": "The CPU never generated the down input for one-way platforms.",
      "fix": "Request a drop when standing on an elevated surface with a nearby rival sufficiently below; reset the request off the surface.",
      "after": "All 20 surfaces, three difficulty levels: the CPU requests down, reaches the floor and releases down. A production browser fight also captured the CPU's real drop-through transition."
    },
    {
      "issue": "CPU cannot reach some rivals waiting on platforms.",
      "before": {
        "command": "node --import tsx --test --test-name-pattern='CPU can climb' tests/platform-physics.test.ts",
        "unreachable": [
          "caracas:0",
          "caracas:1",
          "guaira:0",
          "merida:2",
          "coro:1"
        ]
      },
      "cause": "After the first jump reduced the vertical gap, the old 70-pixel condition suppressed a needed second jump.",
      "fix": "Allow the second jump near or after the first jump's apex while the rival is still above.",
      "after": "105 pursuit scenarios passed: 20 surfaces in three difficulties, with four start phases for every moving surface. The production browser fight captured both fighters standing on the Altamira balcony."
    }
  ],
