{
  "name": "arena-criolla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "creator:codex": "tsx scripts/creator-codex.ts",
    "creator:import": "tsx scripts/creator-import.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs tests/character-audits/*.test.ts",
    "perf:engine": "tsx scripts/performance-audit.ts",
    "perf:network": "node scripts/performance-network.mjs",
    "assets": "node scripts/prepare-assets.mjs && node scripts/prepare-entrance-assets.mjs",
    "assets:entrance": "node scripts/prepare-entrance-assets.mjs",
    "assets:finales": "tsx scripts/prepare-finales.ts",
    "assets:finale-actors": "tsx scripts/prepare-finale-actors.ts",
    "assets:audit:lossless": "node scripts/audit-lossless-assets.mjs",
    "assets:audit:avif": "node scripts/audit-lossless-avif.mjs",
    "assets:publish:lossless": "node scripts/publish-lossless-assets.mjs",
    "assets:verify:lossless": "node scripts/verify-published-lossless.mjs",
    "perf:assets": "tsx scripts/serve-asset-benchmark.ts",
    "perf:assets:report": "node scripts/build-asset-performance-report.mjs",
    "preview:finales": "vite --host 0.0.0.0 --port 5184 --open /docs/finales/gallery.html",
    "assets:og": "node scripts/generate-og-image.mjs",
    "check:assets": "node scripts/validate-character-assets.mjs",
    "test:creator": "tsx --test tests/accounts.test.ts tests/creator-api.test.ts tests/creator.test.ts tests/creator-sprites.test.ts tests/creator-resilience.test.ts tests/adversarial-creator-v31.test.ts tests/provider-contract.test.ts tests/creator-codex.test.ts tests/adversarial-creator-state-v38.test.ts tests/creator-draft-v38.test.ts tests/adversarial-native-import-v38.test.ts tests/creator-api-v38.test.ts",
    "test:adversarial": "tsx --test tests/adversarial-creator-v31.test.ts tests/adversarial-game-v31.test.ts tests/creator-resilience.test.ts tests/provider-contract.test.ts tests/scheduler.test.ts tests/adversarial-creator-state-v38.test.ts tests/creator-draft-v38.test.ts tests/adversarial-native-import-v38.test.ts tests/creator-api-v38.test.ts",
    "test:characters": "tsx --test tests/character-audits/*.test.ts",
    "test:accounts": "tsx --test tests/accounts.test.ts tests/creator-api.test.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.5.0",
    "dotenv": "^18.0.7",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "openai": "^7.32.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openai/codex-sdk": "0.162.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  }
}
