{
  "name": "arena-criolla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production tsx server/index.ts",
    "creator:codex": "tsx scripts/creator-codex.ts",
    "creator:import": "tsx scripts/creator-import.ts",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "perf:engine": "tsx scripts/performance-audit.ts",
    "perf:network": "node scripts/performance-network.mjs",
    "assets:audit:lossless": "node scripts/audit-lossless-assets.mjs",
    "assets:audit:avif": "node scripts/audit-lossless-avif.mjs",
    "assets:og": "node scripts/generate-og-image.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "check:assets": "node scripts/validate-character-assets.mjs"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.5.0",
    "dotenv": "^18.0.7",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "openai": "^7.32.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openai/codex-sdk": "0.162.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0"
  }
}
