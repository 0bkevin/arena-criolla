{
  "name": "arena-criolla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p src --noEmit && tsc -p shared --noEmit",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:ui": "playwright test",
    "perf:engine": "tsx scripts/perf/engine.ts",
    "perf:network": "node scripts/perf/network.mjs",
    "assets:audit:lossless": "tsx scripts/assets/audit-lossless-assets.ts",
    "assets:audit:avif": "tsx scripts/assets/audit-lossless-avif.ts",
    "assets:og": "tsx scripts/assets/generate-og-image.ts",
    "assets:brand": "tsx scripts/assets/generate-brand-assets.ts",
    "assets:busts": "tsx scripts/assets/generate-portrait-busts.ts",
    "assets:stage-thumbs": "tsx scripts/assets/generate-stage-thumbnails.ts",
    "check:assets": "tsx scripts/assets/validate-character-assets.ts",
    "cf:build": "npm run typecheck && vite build && node scripts/cloudflare/prepare.mjs && tsc -p cloudflare --noEmit",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "wrangler": "^4.160.0"
  }
}
